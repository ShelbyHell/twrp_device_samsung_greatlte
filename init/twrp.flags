#<mnt_point>    <type>  <src>                                   <mnt_flags and options>
/boot           emmc    /dev/block/platform/11120000.ufs/by-name/BOOT                   flags=display="Boot";backup=1;flashimg=1;
/recovery       emmc    /dev/block/platform/11120000.ufs/by-name/RECOVERY               flags=display="Recovery";backup=1;flashimg=1;
/data           ext4    /dev/block/platform/11120000.ufs/by-name/USERDATA
/cache          ext4    /dev/block/platform/11120000.ufs/by-name/CACHE                  flags=display="Cache";
/efs            ext4    /dev/block/platform/11120000.ufs/by-name/EFS                    flags=backup=1;display="EFS";
/modem          emmc    /dev/block/platform/11120000.ufs/by-name/RADIO                  flags=backup=1;display="Baseband";
/misc           emmc    /dev/block/platform/11120000.ufs/by-name/MISC
/omr            ext4    /dev/block/platform/11120000.ufs/by-name/OMR                    flags=display="Logs (OMR)";backup=1
/preload        ext4    /dev/block/platform/11120000.ufs/by-name/HIDDEN                  flags=display="Preload";wipeingui

# External Stuff
/external_sd    vfat    /dev/block/mmcblk0p1 /dev/block/mmcblk0 flags=display="External SDCard";storage;wipeingui;removable;